# GitHub Secrets Configuration
# Add these in: GitHub Repo → Settings → Secrets and variables → Actions
#
# Deploy pipeline (deploy.yml — the ONLY production path, TODO-003):
SSH_HOST=unify-cs.ac.ir
SSH_USER=your_cpanel_username
SSH_PRIVATE_KEY=-----BEGIN OPENSSH PRIVATE KEY-----
...
-----END OPENSSH PRIVATE KEY-----
# Host key fingerprint (ssh-keyscan <host> | ssh-keygen -lf -), e.g. SHA256:xxxx
SSH_HOST_KEY_FINGERPRINT=SHA256:your_host_key_fingerprint

# Application Secrets (runtime .env on the server)
PUSHE_API_KEY=your_pushe_api_key
PUSHE_APP_ID=your_pushe_app_id
# Push stays off until explicitly enabled (see docs/DECISIONS.md D-006)
PUSHE_ENABLED=false
KAVENEGAR_API_KEY=your_kavenegar_api_key
KAVENEGAR_ENABLED=false

# Backup/rollback retention
MAX_BACKUPS=5
BACKUP_RETENTION_DAYS=14
