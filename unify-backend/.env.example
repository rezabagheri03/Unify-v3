# Unify V9 - Laravel environment example
# QUICK LOCAL RUN (any OS, incl. Windows): leave as-is (SQLite), then:
#   copy .env.example .env   &&   php artisan key:generate   &&   php artisan serve
# PRODUCTION (Pars Pack Cloud Host): switch DB_CONNECTION=mysql and fill MySQL fields.

APP_NAME=Unify
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8000
API_URL=http://localhost:8000/api/v1

# --- Database: SQLite (works out of the box on Windows/Mac/Linux) ---
# Relative path resolves against the project root; the file is committed and pre-seeded.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# --- Database: MySQL (production on Pars Pack Cloud Host) ---
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=username_unify
# DB_USERNAME=username_dbuser
# DB_PASSWORD=your_strong_password

# Laravel 11 reads CACHE_STORE (CACHE_DRIVER was removed in L11); file store
# keeps throttle counters and short-TTL caches off the shared MySQL.
CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=720

FILESYSTEM_DISK=public

SANCTUM_STATEFUL_DOMAINS=localhost:8000,localhost:5173
SESSION_DOMAIN=localhost
# Personal-access token lifetime, minutes (default 10080 = 7 days); nightly prune via sanctum:prune-expired
SANCTUM_TOKEN_EXPIRATION_MINUTES=10080

# Security
HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12
PASSWORD_PEPPER=
AUDIT_ENCRYPTION_KEY=

# Push (Iranian, intranet-friendly) - optional and OFF by default; polling already
# covers delivery. Enable only with valid credentials (shared-host curl fan-out is slow).
PUSHE_ENABLED=false
PUSHE_API_KEY=
PUSHE_APP_ID=

# SMS (optional) — NOT implemented; flag reserved for future work

# Branding
BRAND_NAME=Unify
LOGO_PATH=/uploads/branding/logo.png

# Limits
MAX_FILE_SIZE_MB=50
STUDENT_DAILY_UPLOAD_LIMIT=5
TICKET_IMAGE_MAX_MB=5
ASSIGNMENT_MAX_MB=20

# Rate limiting (docs/08_ENV_EXAMPLE.md: 5 attempts per 15 minutes)
LOGIN_THROTTLE_MAX_ATTEMPTS=5
LOGIN_THROTTLE_DECAY_MINUTES=15

# Cron / Grace
GRACE_PERIOD_HOURS=24
TICKET_ESCALATION_HOURS=48

# Laravel 11 reads APP_TIMEZONE (TIMEZONE was removed in L11)
APP_TIMEZONE=Asia/Tehran

# TODO-037 perf budget logging (violations only, zero noise under budget):
# PERF_LOGGING=true
# PERF_REQUEST_MS=800       # requests slower than this are logged to perf channel
# PERF_SLOW_QUERY_MS=500    # queries slower than this are logged to perf channel