# Unify V9 — PRODUCTION environment example (Pars Pack Cloud Host, MySQL 8).
# See .env.example for the fully commented variant (limits, throttles, grace).
APP_NAME=Unify
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://unify-cs.ac.ir

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=unify_db
DB_USERNAME=unify_user
DB_PASSWORD=

# Laravel 11 names (CACHE_DRIVER/TIMEZONE were removed in L11)
CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
FILESYSTEM_DISK=public
APP_TIMEZONE=Asia/Tehran

SANCTUM_STATEFUL_DOMAINS=unify-cs.ac.ir,api.unify-cs.ac.ir
SANCTUM_TOKEN_EXPIRATION_MINUTES=10080
CORS_ALLOWED_ORIGINS=https://unify-cs.ac.ir,https://www.unify-cs.ac.ir
# Dev machines append: ,http://localhost:5173


# Security
HASH_DRIVER=argon2id
PASSWORD_PEPPER=
AUDIT_ENCRYPTION_KEY=

# Push/SMS: OFF by default; enable only with valid credentials
PUSHE_ENABLED=false
PUSHE_API_KEY=
PUSHE_APP_ID=
KAVENEGAR_ENABLED=false
KAVENEGAR_API_KEY=

# Rate limiting / cron
LOGIN_THROTTLE_MAX_ATTEMPTS=5
LOGIN_THROTTLE_DECAY_MINUTES=15
GRACE_PERIOD_HOURS=24
TICKET_ESCALATION_HOURS=48
